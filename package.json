{
  "name": "nurimai-desktop",
  "version": "0.8.0",
  "description": "NurimAI — yoningizdagi AI yordamchi",
  "main": "src/main.cjs",
  "author": "NurimAI",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "playwright test",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg zip --universal --publish never",
    "pack": "electron-builder --dir --publish never",
    "configure:release": "node scripts/configure-release.cjs",
    "verify:package": "node scripts/verify-package.cjs",
    "icons": "electron scripts/make-icons.cjs",
    "mobile:sync": "node scripts/mobile-sync.cjs"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "wrangler": "4.151.1"
  }
}
